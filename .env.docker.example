# LLM2Qwen3Guard — Docker Compose 配置模板
# 复制为 .env 后填写。注意：网关只读环境变量；compose 通过 env_file 注入本文件。

# ---- 上游 LLM（OpenAI 兼容，必填三项）----
UPSTREAM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
UPSTREAM_API_KEY=sk-xxxx
UPSTREAM_MODEL=glm-4.7-flash

# ---- 上游调用参数 ----
UPSTREAM_TIMEOUT_SECONDS=120
UPSTREAM_MAX_TOKENS=512
UPSTREAM_TEMPERATURE=0

# ---- 结构化输出 ----
# auto: 先 json_schema，上游 4xx（非 401/403）时降级 json_object 重试一次
# 智谱上游必须用 json_object（无 json_schema 支持）
STRUCTURED_OUTPUT_MODE=json_object
# json_schema 请求是否带 strict:true（OpenRouter 推荐开；SiliconFlow 未文档化，默认关）
UPSTREAM_JSON_SCHEMA_STRICT=false
# 追加进上游请求体的字段（JSON）。智谱关思考：
UPSTREAM_EXTRA_BODY_JSON={"thinking":{"type":"disabled"}}

# ---- 审计行为 ----
# 固定审最后一条 user 消息（sub2api 只做 prompt-input 审计，无 response 模式）
MAX_INPUT_CHARS=32000
# 入站请求体上限（字节，默认 1048576=1MiB）；超限返回 413
MAX_REQUEST_BYTES=1048576

# ---- 失败策略 ----
# error(默认,503 fail-closed) | safe(fail-open 放行) | unsafe(返回 Unsafe 判 Block)
FAILURE_POLICY=error

# ---- 对外服务 ----
# LISTEN_ADDR 由 docker-compose.yml 的 environment 强制为 :8080（优先级高于
# 本文件），此处勿设；如需改端口请改 compose 的 ports 映射。
# 留空则不鉴权；设置后要求 Authorization: Bearer <该值>（对外暴露时务必设置）
GATEWAY_API_KEY=
