# ---- 上游 LLM（OpenAI 兼容，必填三项）----
# 千问DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1  模型: qwen-flash（已实测）
# 智谱:  https://open.bigmodel.cn/api/paas/v4   模型: glm-4.7-flash（需 json_object + 关思考）
# OpenRouter: https://openrouter.ai/api/v1
# 硅基流动: https://api.siliconflow.com/v1
UPSTREAM_BASE_URL=http://localhost:8317/v1
UPSTREAM_API_KEY=sk-xxxx
UPSTREAM_MODEL=deepseek-v4-flash

# ---- 上游调用参数 ----
UPSTREAM_TIMEOUT_SECONDS=30
UPSTREAM_MAX_TOKENS=512
UPSTREAM_TEMPERATURE=0

# ---- 结构化输出 ----
# auto: 先 json_schema，上游 4xx（非 401/403）时降级 json_object 重试一次
STRUCTURED_OUTPUT_MODE=auto
# json_schema 请求是否带 strict:true（OpenRouter 推荐开；SiliconFlow 未文档化，默认关）
UPSTREAM_JSON_SCHEMA_STRICT=false
# 追加进上游请求体的字段（JSON）。智谱关思考示例：
# UPSTREAM_EXTRA_BODY_JSON={"thinking":{"type":"disabled"}}

# ---- 审计行为 ----
# 固定审最后一条 user 消息（sub2api 只做 prompt-input 审计，无 response 模式）
# 自定义审查侧重：指向文本文件，内容插入官方政策之后（见 policy-appendix.example.txt）
# AUDIT_POLICY_APPEND_FILE=policy-appendix.example.txt
# 输入截断（sub2api 默认分块 4000；0=不限制）
MAX_INPUT_CHARS=32000
# 入站请求体上限（字节，默认 1048576=1MiB）；超限返回 413
MAX_REQUEST_BYTES=1048576

# ---- 日志 ----
# 文件日志目录（默认 logs，按日轮转 gateway-YYYYMMDD.jsonl）；off 关闭文件日志（Docker 用）
LOG_DIR=logs
# debug | info | warn | error
LOG_LEVEL=info

# ---- 失败策略 ----
# error(默认,503 fail-closed) | safe(fail-open 放行) | unsafe(返回 Unsafe 判 Block)
FAILURE_POLICY=error

# ---- 对外服务 ----
LISTEN_ADDR=:8080
# 留空则不鉴权；设置后要求 Authorization: Bearer <该值>
GATEWAY_API_KEY=
